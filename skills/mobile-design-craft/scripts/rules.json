{
  "rules": [
    {
      "id": "gradient-purple",
      "severity": "error",
      "files": "code",
      "pattern": "(purple|violet|indigo|#8b5cf6|#7c3aed|#6366f1|#a855f7)[^\\n]{0,80}(LinearGradient|gradient)|(LinearGradient|gradient)[^\\n]{0,120}(purple|violet|indigo|#8b5cf6|#7c3aed|#6366f1|#a855f7)|\\bfrom-(purple|violet|indigo)-\\d",
      "flags": "i",
      "fix": "Remove the default purple/indigo gradient; use the token palette."
    },
    {
      "id": "lorem",
      "severity": "error",
      "files": "all",
      "pattern": "lorem ipsum|dolor sit amet|placeholder\\.com|via\\.placeholder|John Doe|Jane Doe",
      "flags": "i",
      "fix": "Write real, specific copy or mark TODO(content)."
    },
    {
      "id": "copy-banned",
      "severity": "warn",
      "files": "code",
      "pattern": "['\\\"`>][^'\\\"`<]{0,120}\\b(unleash|unlock your|elevate|seamless(ly)?|effortless(ly)?|supercharge|empower|revolutioni[sz]e|game[- ]changer|cutting[- ]edge|next[- ]gen|world[- ]class)\\b",
      "flags": "i",
      "fix": "Replace with a concrete noun and verb specific to this app."
    },
    {
      "id": "em-dash",
      "severity": "warn",
      "files": "all",
      "pattern": "\u2014",
      "flags": "",
      "fix": "Use a period, comma or colon in UI copy."
    },
    {
      "id": "rn-touchable-legacy",
      "severity": "warn",
      "files": "code",
      "pattern": "\\bTouchable(Opacity|Highlight|WithoutFeedback)\\b",
      "flags": "",
      "fix": "Use Pressable with a pressed style, or a Gesture Handler button."
    },
    {
      "id": "rn-image-core",
      "severity": "warn",
      "files": "code",
      "pattern": "import\\s*\\{[^}]*\\bImage\\b[^}]*\\}\\s*from\\s*['\\\"]react-native['\\\"]",
      "flags": "",
      "fix": "Import Image from expo-image for caching, placeholders and transitions.",
      "scope": "file"
    },
    {
      "id": "rn-image-background",
      "severity": "warn",
      "files": "code",
      "pattern": "\\bImageBackground\\b",
      "flags": "",
      "fix": "Deprecated in RN 0.88. Use a View with an absolutely positioned expo-image Image."
    },
    {
      "id": "rn-animated-legacy",
      "severity": "warn",
      "files": "code",
      "pattern": "import\\s*\\{[^}]*\\bAnimated\\b[^}]*\\}\\s*from\\s*['\\\"]react-native['\\\"]",
      "flags": "",
      "fix": "Use react-native-reanimated: CSS transitions for state changes, worklets for gestures.",
      "scope": "file"
    },
    {
      "id": "rn-safeareaview-core",
      "severity": "error",
      "files": "code",
      "pattern": "import\\s*\\{[^}]*\\bSafeAreaView\\b[^}]*\\}\\s*from\\s*['\\\"]react-native['\\\"]",
      "flags": "",
      "fix": "Deprecated and not edge-to-edge safe. Use react-native-safe-area-context.",
      "scope": "file"
    },
    {
      "id": "rn-scrollview-map",
      "severity": "warn",
      "files": "code",
      "pattern": "<ScrollView\\b[\\s\\S]{0,400}?\\.map\\(",
      "flags": "",
      "fix": "For long or unbounded data use FlashList v2 or LegendList with keyExtractor.",
      "scope": "file"
    },
    {
      "id": "rn-estimated-item-size",
      "severity": "info",
      "files": "code",
      "pattern": "\\bestimatedItemSize\\b",
      "flags": "",
      "fix": "FlashList v2 ignores size estimates. Remove unless pinned to v1."
    },
    {
      "id": "rn-hardcoded-color",
      "severity": "warn",
      "files": "code",
      "pattern": "\\b(color|backgroundColor|borderColor|tintColor|shadowColor)\\s*:\\s*['\\\"](#[0-9a-fA-F]{3,8}|rgba?\\()",
      "flags": "",
      "fix": "Use semantic theme tokens (useTheme().colors.*). Raw colors belong only in the theme folder.",
      "excludePath": "(^|/)(theme|constants|tokens)/"
    },
    {
      "id": "rn-font-scaling-off",
      "severity": "error",
      "files": "code",
      "pattern": "allowFontScaling\\s*[=:]\\s*\\{?\\s*false",
      "flags": "",
      "fix": "Keep font scaling on. Cap dense chrome with maxFontSizeMultiplier of 1.3 or more instead."
    },
    {
      "id": "rn-font-multiplier-low",
      "severity": "warn",
      "files": "code",
      "pattern": "maxFontSizeMultiplier\\s*[=:]\\s*\\{?\\s*1(\\.[0-2]\\d*)?\\s*[}\\s,;]",
      "flags": "",
      "fix": "Multipliers below 1.3 block Dynamic Type users. Raise it or let the layout grow."
    },
    {
      "id": "rn-icon-button-no-label",
      "severity": "warn",
      "files": "code",
      "pattern": "<Pressable\\b(?:(?!accessibilityLabel|aria-label)(?:=>|[^>]))*>\\s*<(Ionicons|MaterialIcons|MaterialCommunityIcons|Feather|SymbolView|Icon|[A-Z]\\w*Icon)\\b",
      "flags": "",
      "fix": "Icon-only buttons need accessibilityRole=\"button\" and accessibilityLabel.",
      "scope": "file"
    },
    {
      "id": "rn-interaction-manager",
      "severity": "error",
      "files": "code",
      "pattern": "\\bInteractionManager\\b",
      "flags": "",
      "fix": "Removed in RN 0.87. Use requestIdleCallback."
    },
    {
      "id": "rn-deep-import",
      "severity": "error",
      "files": "code",
      "pattern": "from\\s*['\\\"]react-native/Libraries/",
      "flags": "",
      "fix": "Deep imports are type errors under the Strict TypeScript API (RN 0.87+). Import from 'react-native'."
    },
    {
      "id": "rn-statusbar-removed-props",
      "severity": "error",
      "files": "code",
      "pattern": "<StatusBar\\b[^>]*\\b(backgroundColor|translucent)\\b",
      "flags": "",
      "fix": "Removed in RN 0.88. Android is edge-to-edge; use expo-status-bar style only.",
      "scope": "file"
    },
    {
      "id": "rn-dimensions-get",
      "severity": "warn",
      "files": "code",
      "pattern": "Dimensions\\.get\\(",
      "flags": "",
      "fix": "Use useWindowDimensions so layouts react to resize and foldables."
    },
    {
      "id": "rn-orientation-lock",
      "severity": "info",
      "files": "code",
      "pattern": "\\block(Async|PlatformAsync)\\(",
      "flags": "",
      "fix": "iOS 27 may ignore orientation locks while resizable. Design for any size."
    },
    {
      "id": "rn-keyboard-avoiding",
      "severity": "info",
      "files": "code",
      "pattern": "\\bKeyboardAvoidingView\\b",
      "flags": "",
      "fix": "Prefer react-native-keyboard-controller (KeyboardAwareScrollView, KeyboardStickyView)."
    },
    {
      "id": "rn-emoji-icon",
      "severity": "info",
      "files": "code",
      "pattern": "(tabBarIcon|icon)\\s*[=:][^\\n]{0,40}['\"`>][\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]",
      "flags": "u",
      "fix": "Use SF Symbols (expo-symbols) or Material Symbols, not emoji, for icons."
    },
    {
      "id": "rn-pure-black-bg",
      "severity": "info",
      "files": "code",
      "pattern": "backgroundColor\\s*:\\s*['\\\"](#000|#000000|black)['\\\"]",
      "flags": "",
      "fix": "Use a tinted near-black dark surface token unless OLED black is a deliberate brand choice."
    }
  ]
}
